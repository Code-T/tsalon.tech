---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, getEventState } from '../lib/event-display';

interface Props { event: CollectionEntry<'events'>; }
const { event } = Astro.props;
const { ended, registrationOpen, status } = getEventState(event.data.endDate, event.data.registration);
const href = `/events/${event.id}/`;
const cta = ended ? '活动档案' : status === 'waitlist' ? '候补报名' : registrationOpen ? '立即报名' : '活动详情';
const state = ended ? '已结束' : status === 'waitlist' ? '候补报名' : registrationOpen ? '正在报名' : '报名已关闭';
const stateClass = ended ? 'is-ended' : registrationOpen ? 'is-open' : 'is-upcoming';
const date = formatEventDate(event.data.startDate, 'zh-CN', event.data.timezone).replaceAll('/', '.');
const mode = event.data.attendanceMode === 'offline' ? '线下' : event.data.attendanceMode === 'online' ? '线上' : '线上 + 线下';
---
<a
  class="event-tile"
  href={href}
>
  <figure class="event-tile-media">
    <img src={event.data.cover} alt={event.data.coverAlt} loading="lazy" />
  </figure>
  <div class="event-tile-body">
    <p class="event-tile-series mono"><span>{event.data.series} / {mode}</span><i class:list={['event-tile-status', stateClass]}>{state}</i></p>
    <h3>{event.data.title}</h3>
    <div class="event-tile-facts">
      <span><i>日期</i>{date}</span>
      <span><i>地点</i>{event.data.city ?? mode}</span>
    </div>
    <strong class="event-tile-action">{cta} <i>→</i></strong>
  </div>
</a>
