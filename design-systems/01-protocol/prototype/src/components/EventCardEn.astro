---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, getEventState } from '../lib/event-display';

interface Props { event: CollectionEntry<'eventsEn'>; }
const { event } = Astro.props;
const { ended, registrationOpen, status } = getEventState(event.data.endDate, event.data.registration);
const href = `/en/events/${event.id}/`;
const cta = ended ? 'Event archive' : status === 'waitlist' ? 'Join waitlist' : registrationOpen ? 'Register now' : 'Event details';
const state = ended ? 'Ended' : status === 'waitlist' ? 'Waitlist open' : registrationOpen ? 'Registration open' : 'Registration closed';
const stateClass = ended ? 'is-ended' : registrationOpen ? 'is-open' : 'is-upcoming';
const date = formatEventDate(event.data.startDate, 'en', event.data.timezone, { year: 'numeric', month: 'short', day: 'numeric' });
const mode = event.data.attendanceMode === 'offline' ? 'In person' : event.data.attendanceMode === 'online' ? 'Online' : 'Hybrid';
---
<a
  class="event-tile"
  href={href}
>
  <figure class="event-tile-media">
    <img src={event.data.cover} alt={event.data.coverAlt} loading="lazy" />
  </figure>
  <div class="event-tile-body">
    <p class="event-tile-series mono"><span>{event.data.series.toUpperCase()} / {mode}</span><i class:list={['event-tile-status', stateClass]}>{state}</i></p>
    <h3>{event.data.title}</h3>
    <div class="event-tile-facts">
      <span><i>Date</i>{date}</span>
      <span><i>Location</i>{event.data.city ?? mode}</span>
    </div>
    <strong class="event-tile-action">{cta} <i>→</i></strong>
  </div>
</a>
