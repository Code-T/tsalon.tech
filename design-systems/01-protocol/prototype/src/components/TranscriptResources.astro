---
import transcripts from '../data/transcripts.json';
interface Props { talkId: string; }
interface TranscriptResource {
  talkId: string;
  title: string;
  sourceUrl: string;
  textUrl: string;
  subtitleUrl: string;
  method: 'automatic' | 'source-subtitle';
  subtitleOrigin?: 'automatic' | 'unverified';
}
const parts = (transcripts as TranscriptResource[]).filter(part => part.talkId === Astro.props.talkId);
const provenance = (part: TranscriptResource) => part.method === 'automatic'
  ? '完整音轨自动转录'
  : part.subtitleOrigin === 'automatic'
    ? '来源自动字幕 · 完整字幕文件，未用音轨转录补全'
    : '来源字幕 · 生成方式未核实，已读取完整字幕文件，未用音轨转录补全';
---
{parts.length > 0 && <section class="transcript-resources" aria-label="文字转录与字幕">
  <h2>文字转录与字幕</h2>
  <p>以下文件带原片时间码。自动转录和来源字幕均未经逐句人工校听，专名和个别语句可能有错误；字幕覆盖范围以原片为准，文字回顾另经编辑整理。</p>
  <ul>{parts.map(part => <li><strong>{part.title}</strong><p>{provenance(part)}</p><div><a href={part.textUrl}>阅读文字（TXT）</a><a href={part.subtitleUrl} download>下载字幕（SRT）</a><a href={part.sourceUrl} target="_blank" rel="noopener noreferrer">对照原片 ↗</a></div></li>)}</ul>
</section>}
<style>
  .transcript-resources { margin-block: 2rem; padding: 1.25rem; background: var(--background-subtle, #f5f5f5); border: 1px solid var(--border-default, #ddd); }
  .transcript-resources h2 { margin-top: 0; }
  .transcript-resources ul { padding-left: 1.2rem; }
  .transcript-resources li { margin-block: 1rem; }
  .transcript-resources li div { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: .5rem; }
  .transcript-resources a { overflow-wrap: anywhere; }
</style>
