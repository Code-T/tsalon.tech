---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getResetRadarData } from '../../../lib/reset-radar';

export const prerender = false;

const radarData = await getResetRadarData();
const { codex, claude, updatedAtBeijing, status } = radarData;

const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const faqItems = [
  {
    "q": "How do global resets, scoped resets, and reset cards differ?",
    "a": "This page labels a reset as global only when its record specifies all users. Other resets retain their stated scope. A reset-card record describes a card event, not an automatic reset for every account. Check the linked original post for eligibility and use instructions. None of these records establishes your personal quota balance."
  },
  {
    "q": "Can I calculate recovery from the time I hit a limit?",
    "a": "No. Reaching a limit does not establish the window start. The calculator adds five hours to a <strong>known window start</strong> that you enter. Its result is only the end of that assumed window. Products and plans may have different or additional limits; use the time and quota shown in the product."
  },
  {
    "q": "How is the historical reference point calculated?",
    "a": "We take up to 10 distinct global-reset timestamps in the loaded records and calculate the median of their adjacent intervals. The reference point is the latest global reset plus that median. Reset cards and scoped resets are excluded. Fewer than two global resets produces no reference point. This is historical arithmetic, not an official schedule or a personal recovery forecast."
  },
  {
    "q": "Where do the records come from?",
    "a": "T Salon reads the <a href=\"https://whenreset.dev/api/resets\" target=\"_blank\" rel=\"noreferrer\">WhenReset.dev record feed</a> when this page is requested, with a five-minute cache. Original posts are linked in each record. “Read at” is the feed retrieval time, not evidence of a new reset. A failed request is shown as unavailable; the feed may be incomplete."
  }
];

const pageUrl = new URL('/en/whenreset/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI Quota Reset Radar',
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description:
      'Browse Codex and Claude reset and reset-card records from WhenReset.dev in Beijing time, with original-post links, historical interval references, and a calculator based on a known window start and an explicit five-hour assumption.',
    publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: pageUrl,
    inLanguage: 'en',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  },
];
---

<BaseLayout
  title="AI Quota Reset Radar — Event Records | T Salon"
  description="Browse Codex and Claude reset records from WhenReset.dev, follow original posts, and calculate an assumed five-hour window from a known start."
  alternatePath="/whenreset/"
  locale="en"
  jsonLd={jsonLd}
>
  <main class="reset-page">
    <div class="container">
      <!-- Top Title & Live Status -->
      <section class="reset-hero">
        <div class="hero-top-badge">
          <span class:list={['pulse-dot', { unavailable: status === 'unavailable' }]}></span>
          <span>{status === 'unavailable' ? 'WhenReset.dev records are temporarily unavailable' : status === 'empty' ? 'No records returned by WhenReset.dev' : 'WhenReset.dev records'}{updatedAtBeijing && ` · Read at ${updatedAtBeijing} (UTC+8)`}</span>
        </div>
        <h1 class="hero-title">AI Quota Reset Radar</h1>
        <p class="hero-desc">Records from <a href="https://whenreset.dev/" target="_blank" rel="noreferrer">WhenReset.dev</a>, with original posts linked in each row. Event times use Beijing time (UTC+8). Global resets, scoped resets, and reset cards do not establish your personal quota recovery time.</p>

        <!-- Provider Switcher Tabs -->
        <div class="provider-tabs">
          <button class="tab-btn active" data-provider="codex">
            <span class="tab-icon">⚡️</span>
            <span class="tab-name">OpenAI Codex</span>
            <span class="tab-badge">Records</span>
          </button>
          <button class="tab-btn" data-provider="claude">
            <span class="tab-icon">🧠</span>
            <span class="tab-name">Anthropic Claude</span>
            <span class="tab-badge">Records</span>
          </button>
        </div>
      </section>

      <!-- Codex Section -->
      <div id="section-codex" class="provider-section active">
        {codex.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{codex.watchNotice.titleEn || "Notice in the source feed"}</div>
              <p class="alert-text">{codex.watchNotice.text}</p>
              {codex.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">Scheduled in the source: {codex.watchNotice.scheduledAtBeijing} (UTC+8)</div>
              )}
            </div>
            {codex.watchNotice.tweetUrl && (
              <a href={codex.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                Source Post <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">Latest recorded event</div>
            <div class="card-value highlight">{codex.latestEvent?.typeLabelEn || 'No record'}</div>
            <div class="card-sub">{codex.latestEvent?.timeAgoEn || '—'}</div>
            <div class="card-sub">Applies to: {codex.latestEvent?.scopeEn || 'Not specified'}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">Time of that event (UTC+8)</div>
            <div class="card-value">{codex.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">Reason: {codex.latestEvent?.reasonEn || 'Not specified in this record'}</div>
            {codex.latestEvent?.postUrl && (
              <a href={codex.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">Original post for this event ↗</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">Historical interval reference</div>
            <div class="card-value">{codex.nextEstimated.dateBeijing} <span class="time-sub">{codex.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{codex.nextEstimated.relativeTextEn}</div>
            <div class="card-hint">Based on {codex.cadenceIntervalCount} global-reset intervals; not an official schedule</div>
          </div>
          <div class="bento-card">
            <div class="card-label">Median global-reset interval</div>
            <div class="card-value">{codex.typicalGapDays ?? '—'} <span class="unit">days</span></div>
            <div class="card-sub">Loaded records in the last 30 days: {status === 'unavailable' ? '—' : codex.resets30d} resets, {status === 'unavailable' ? '—' : codex.cards30d} card events</div>
            <div class="card-hint">Source: WhenReset.dev · records may be incomplete</div>
          </div>
        </div>

        <!-- Window Time Calculator -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">Five-hour window time calculator</h2>
              <p class="tool-sub">Enter a known window start, not the moment you hit a limit. This calculates only an assumed five-hour end time. Use the reset time shown in the product for your account.</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="codex-window-start">Known window start (Beijing time, UTC+8)</label>
              <input type="datetime-local" id="codex-window-start" class="time-input" step="60" />
              <button type="button" id="codex-calculate" class="btn btn-dark">Calculate with 5 hours</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
              <div class="result-label">Assumed window end (Beijing time, UTC+8)</div>
              <div class="result-time" id="codex-calc-result">—</div>
              <div class="result-tips" id="codex-calc-tips">Enter a known start and select the calculation button.</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Codex Reset and Reset-Card History</h2>
            <span class="history-count">Up to 30 loaded records · Beijing time (UTC+8)</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>Date (UTC+8)</th>
                  <th>Type</th>
                  <th>Applies to</th>
                  <th>Reason / Context</th>
                  <th>Age</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {codex.events.length === 0 && <tr><td colspan="6">No available event records.</td></tr>}
                {codex.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>
                        {e.typeLabelEn}
                      </span>
                    </td>
                    <td class="cell-scope">{e.scopeEn}</td>
                    <td class="cell-reason">{e.reasonEn}</td>
                    <td class="cell-timeago">{e.timeAgoEn}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          Post ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Claude Section -->
      <div id="section-claude" class="provider-section">
        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">Latest recorded event</div>
            <div class="card-value highlight">{claude.latestEvent?.typeLabelEn || 'No record'}</div>
            <div class="card-sub">{claude.latestEvent?.timeAgoEn || '—'}</div>
            <div class="card-sub">Applies to: {claude.latestEvent?.scopeEn || 'Not specified'}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">Time of that event (UTC+8)</div>
            <div class="card-value">{claude.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">Reason: {claude.latestEvent?.reasonEn || 'Not specified in this record'}</div>
            {claude.latestEvent?.postUrl && (
              <a href={claude.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">Original post for this event ↗</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">Historical interval reference</div>
            <div class="card-value">{claude.nextEstimated.dateBeijing} <span class="time-sub">{claude.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{claude.nextEstimated.relativeTextEn}</div>
            <div class="card-hint">Based on {claude.cadenceIntervalCount} global-reset intervals; not an official schedule</div>
          </div>
          <div class="bento-card">
            <div class="card-label">Median global-reset interval</div>
            <div class="card-value">{claude.typicalGapDays ?? '—'} <span class="unit">days</span></div>
            <div class="card-sub">Loaded records in the last 30 days: {status === 'unavailable' ? '—' : claude.resets30d} resets, {status === 'unavailable' ? '—' : claude.cards30d} card events</div>
            <div class="card-hint">Source: WhenReset.dev · records may be incomplete</div>
          </div>
        </div>

        <!-- Window Time Calculator for Claude -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">Five-hour window time calculator</h2>
              <p class="tool-sub">Enter a known window start, not the moment you hit a limit. This calculates only an assumed five-hour end time. Use the reset time shown in the product for your account.</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="claude-window-start">Known window start (Beijing time, UTC+8)</label>
              <input type="datetime-local" id="claude-window-start" class="time-input" step="60" />
              <button type="button" id="claude-calculate" class="btn btn-dark">Calculate with 5 hours</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
              <div class="result-label">Assumed window end (Beijing time, UTC+8)</div>
              <div class="result-time" id="claude-calc-result">—</div>
              <div class="result-tips" id="claude-calc-tips">Enter a known start and select the calculation button.</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Claude Reset and Reset-Card History</h2>
            <span class="history-count">Up to 30 loaded records · Beijing time (UTC+8)</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>Date (UTC+8)</th>
                  <th>Type</th>
                  <th>Applies to</th>
                  <th>Reason / Context</th>
                  <th>Age</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {claude.events.length === 0 && <tr><td colspan="6">No available event records.</td></tr>}
                {claude.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>{e.typeLabelEn}</span>
                    </td>
                    <td class="cell-scope">{e.scopeEn}</td>
                    <td class="cell-reason">{e.reasonEn}</td>
                    <td class="cell-timeago">{e.timeAgoEn}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          Post ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- FAQ & Strategy Section -->
      <section class="faq-section">
        <h2 class="faq-main-title">Frequently Asked Questions</h2>
        <div class="faq-grid">
          {faqItems.map((item) => (
            <div class="faq-item">
              <h3 class="faq-q">{item.q}</h3>
              <p class="faq-a" set:html={item.a} />
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initResetWindowCalculator } from '../../../lib/reset-window';
  // Tab Switcher
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const sections = document.querySelectorAll<HTMLElement>('.provider-section');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const provider = btn.dataset.provider;
      tabBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      sections.forEach((sec) => {
        if (sec.id === `section-${provider}`) {
          sec.classList.add('active');
        } else {
          sec.classList.remove('active');
        }
      });
    });
  });

  initResetWindowCalculator('codex', 'en');
  initResetWindowCalculator('claude', 'en');
</script>

<style>
  .pulse-dot.unavailable { background: var(--text-tertiary); animation: none; }
  .reset-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
    min-height: 80vh;
  }

  .reset-hero {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-default);
  }

  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 12px;
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    font-size: var(--text-12);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    border-radius: 999px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }

  .hero-desc {
    max-width: 680px;
    color: var(--text-secondary);
    font-size: var(--text-15);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  .provider-tabs {
    display: flex;
    gap: var(--space-3);
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: var(--text-14);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-standard);
  }

  .tab-btn:hover {
    background: #fff;
    border-color: var(--color-ink-950);
    color: var(--color-ink-950);
  }

  .tab-btn.active {
    background: var(--color-ink-950);
    color: #fff;
    border-color: var(--color-ink-950);
  }

  .tab-badge {
    font-size: var(--text-10);
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .tab-btn:not(.active) .tab-badge {
    background: var(--border-default);
    color: var(--text-secondary);
  }

  .provider-section {
    display: none;
  }

  .provider-section.active {
    display: block;
  }

  /* Alert Banner */
  .alert-banner {
    margin-bottom: var(--space-8);
    padding: var(--space-5) var(--space-6);
    background: #fffbeb;
    border: 1px solid #fde68a;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .alert-icon {
    font-size: 1.8rem;
  }

  .alert-content {
    flex: 1;
  }

  .alert-title {
    font-weight: var(--font-weight-bold);
    color: #92400e;
    margin-bottom: 2px;
  }

  .alert-text {
    font-size: var(--text-13);
    color: #78350f;
    margin: 0;
  }

  .alert-meta {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: #b45309;
    margin-top: 4px;
  }

  .alert-btn {
    white-space: nowrap;
  }

  /* Stats Bento Grid */
  .stats-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .bento-card {
    background: #fff;
    border: 1px solid var(--border-default);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .card-label {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .card-value {
    font-size: 1.85rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-950);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }

  .card-value.highlight {
    color: #2563eb;
  }

  .card-value.accent {
    color: #059669;
  }

  .card-value.warn {
    color: #ea580c;
  }

  .time-sub {
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--text-secondary);
  }

  .unit {
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--text-tertiary);
  }

  .card-sub {
    font-size: var(--text-12);
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .card-hint {
    font-size: var(--text-10);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .card-link {
    font-size: var(--text-11);
    color: #2563eb;
    margin-top: var(--space-2);
    text-decoration: underline;
  }

  .text-truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Window time calculator */
  .tool-card {
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    padding: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .tool-header {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }

  .tool-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .tool-title {
    font-size: var(--text-18);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-1);
  }

  .tool-sub {
    font-size: var(--text-13);
    color: var(--text-secondary);
    margin: 0;
  }

  .calc-row {
    flex-wrap: wrap;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background: #fff;
    border: 1px solid var(--border-default);
    padding: var(--space-6);
  }

  .calc-input-group {
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .calc-input-group label {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }

  .time-input {
    max-width: 100%;
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-bold);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-default);
    background: var(--background-subtle);
  }

  .calc-arrow {
    font-size: 1.5rem;
    color: var(--text-tertiary);
  }

  .calc-result-box {
    flex: 1 1 240px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .result-label {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }

  .result-time {
    overflow-wrap: anywhere;
    font-size: 1.4rem;
    font-weight: var(--font-weight-bold);
    color: #059669;
    font-family: var(--font-mono);
  }

  .result-tips {
    font-size: var(--text-12);
    color: var(--text-secondary);
  }

  /* Table Section */
  .history-section {
