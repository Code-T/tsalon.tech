---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResetRadarData } from '../../lib/reset-radar';

export const prerender = false;

const radarData = await getResetRadarData();
const { codex, claude, updatedAtBeijing, status } = radarData;

const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const faqItems = [
  {
    "q": "全局重置、指定范围重置和重置卡有什么区别？",
    "a": "本页只将范围标为全部用户的重置记录称为全局重置；其他重置保留记录中的适用范围。重置卡记录表示发卡事件，不代表所有账号已自动重置。资格、使用方式和有效期请查看该条原帖。这些记录都不能确定你的个人剩余额度。"
  },
  {
    "q": "能从触顶时间算出恢复时间吗？",
    "a": "不能。触顶时刻不等于窗口起点。计算器只对你输入的<strong>已知窗口起点</strong>加 5 小时，结果仅表示该假设下的窗口结束时间。不同产品和套餐可能有不同或额外限额，请以产品内显示的时间和额度为准。"
  },
  {
    "q": "历史间隔参考点如何计算？",
    "a": "从本次读取的记录中取最近最多 10 个不同的全局重置时刻，计算相邻间隔的中位数，再加到最近一次全局重置时刻上。重置卡和指定范围重置不参与计算。全局重置少于两次时不显示参考点。这只是历史时间计算，不是官方排期，也不是个人额度恢复预测。"
  },
  {
    "q": "记录来自哪里？",
    "a": "T Salon 在页面被请求时读取 <a href=\"https://whenreset.dev/api/resets\" target=\"_blank\" rel=\"noreferrer\">WhenReset.dev 记录接口</a>，缓存 5 分钟，各条记录附原帖链接。“读取时间”表示获取来源数据的时刻，不代表刚发生新重置。请求失败时显示暂不可用；来源记录可能不完整。"
  }
];

const pageUrl = new URL('/whenreset/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI 编程额度重置雷达',
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description:
      '查看 WhenReset.dev 收录的 Codex 与 Claude 重置和重置卡记录、北京时间与原帖链接，提供历史间隔参考及基于已知窗口起点的五小时时间计算。',
    publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: pageUrl,
    inLanguage: 'zh-CN',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  },
];
---

<BaseLayout
  title="AI 编程额度重置雷达 · 事件记录 | T Salon"
  description="查看 WhenReset.dev 收录的 Codex、Claude 重置和重置卡记录及原帖，区分事件范围，并按已知窗口起点计算假设的五小时结束时间。"
  alternatePath="/en/whenreset/"
  locale="zh"
  jsonLd={jsonLd}
>
  <main class="reset-page">
    <div class="container">
      <!-- Top Title & Live Status -->
      <section class="reset-hero">
        <div class="hero-top-badge">
          <span class:list={['pulse-dot', { unavailable: status === 'unavailable' }]}></span>
          <span>{status === 'unavailable' ? '暂时无法读取 WhenReset.dev 记录' : status === 'empty' ? 'WhenReset.dev 暂无可用记录' : 'WhenReset.dev 事件记录'}{updatedAtBeijing && ` · 北京时间 ${updatedAtBeijing} 读取`}</span>
        </div>
        <h1 class="hero-title">AI 编程额度重置雷达</h1>
        <p class="hero-desc">记录来源为 <a href="https://whenreset.dev/" target="_blank" rel="noreferrer">WhenReset.dev</a>，原帖见各条记录，事件时间统一为北京时间。全局重置、指定范围重置与重置卡均不代表你的个人额度恢复时间。</p>

        <!-- Provider Switcher Tabs -->
        <div class="provider-tabs">
          <button class="tab-btn active" data-provider="codex">
            <span class="tab-icon">⚡️</span>
            <span class="tab-name">OpenAI Codex</span>
            <span class="tab-badge">事件记录</span>
          </button>
          <button class="tab-btn" data-provider="claude">
            <span class="tab-icon">🧠</span>
            <span class="tab-name">Anthropic Claude</span>
            <span class="tab-badge">事件记录</span>
          </button>
        </div>
      </section>

      <!-- Codex Section -->
      <div id="section-codex" class="provider-section active">
        {codex.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{codex.watchNotice.titleZh || "来源中的待发生通知"}</div>
              <p class="alert-text">{codex.watchNotice.text}</p>
              {codex.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">来源所列时间：北京时间 {codex.watchNotice.scheduledAtBeijing}</div>
              )}
            </div>
            {codex.watchNotice.tweetUrl && (
              <a href={codex.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                查看来源原帖 <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">最近一条事件</div>
            <div class="card-value highlight">{codex.latestEvent?.typeLabelZh || '暂无记录'}</div>
            <div class="card-sub">{codex.latestEvent?.timeAgoZh || '—'}</div>
            <div class="card-sub">适用范围：{codex.latestEvent?.scopeZh || '未说明'}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">该事件时间（北京时间）</div>
            <div class="card-value">{codex.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">原因：{codex.latestEvent?.reasonZh || '该记录未说明'}</div>
            {codex.latestEvent?.postUrl && (
              <a href={codex.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">该事件原帖 ↗</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">历史间隔参考点</div>
            <div class="card-value">{codex.nextEstimated.dateBeijing} <span class="time-sub">{codex.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{codex.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">基于 {codex.cadenceIntervalCount} 个全局重置间隔，不是官方排期</div>
          </div>
          <div class="bento-card">
            <div class="card-label">全局重置间隔中位数</div>
            <div class="card-value">{codex.typicalGapDays ?? '—'} <span class="unit">天</span></div>
            <div class="card-sub">已读取的近 30 天记录：{status === 'unavailable' ? '—' : codex.resets30d} 次重置，{status === 'unavailable' ? '—' : codex.cards30d} 次发卡</div>
            <div class="card-hint">来源：WhenReset.dev · 记录可能不完整</div>
          </div>
        </div>

        <!-- Window Time Calculator -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">五小时窗口时间计算器</h2>
              <p class="tool-sub">填写已知窗口起点，不是触顶时刻。这里只按五小时假设计算结束时间；个人实际重置时间请以产品内显示为准。</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="codex-window-start">已知窗口起点（北京时间）</label>
              <input type="datetime-local" id="codex-window-start" class="time-input" step="60" />
              <button type="button" id="codex-calculate" class="btn btn-dark">按 5 小时计算</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
              <div class="result-label">假设窗口结束时间（北京时间）</div>
              <div class="result-time" id="codex-calc-result">—</div>
              <div class="result-tips" id="codex-calc-tips">输入已知起点后点击计算按钮。</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Codex 重置与重置卡记录</h2>
            <span class="history-count">最多 30 条已读取记录 · 北京时间</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>日期 (北京时间)</th>
                  <th>类型</th>
                  <th>适用范围</th>
                  <th>触发原因 / 说明</th>
                  <th>距今</th>
                  <th>出处</th>
                </tr>
              </thead>
              <tbody>
                {codex.events.length === 0 && <tr><td colspan="6">暂无可用事件记录。</td></tr>}
                {codex.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>
                        {e.typeLabelZh}
                      </span>
                    </td>
                    <td class="cell-scope">{e.scopeZh}</td>
                    <td class="cell-reason">{e.reasonZh}</td>
                    <td class="cell-timeago">{e.timeAgoZh}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          推文 ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Claude Section -->
      <div id="section-claude" class="provider-section">
        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">最近一条事件</div>
            <div class="card-value highlight">{claude.latestEvent?.typeLabelZh || '暂无记录'}</div>
            <div class="card-sub">{claude.latestEvent?.timeAgoZh || '—'}</div>
            <div class="card-sub">适用范围：{claude.latestEvent?.scopeZh || '未说明'}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">该事件时间（北京时间）</div>
            <div class="card-value">{claude.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">原因：{claude.latestEvent?.reasonZh || '该记录未说明'}</div>
            {claude.latestEvent?.postUrl && (
              <a href={claude.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">该事件原帖 ↗</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">历史间隔参考点</div>
            <div class="card-value">{claude.nextEstimated.dateBeijing} <span class="time-sub">{claude.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{claude.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">基于 {claude.cadenceIntervalCount} 个全局重置间隔，不是官方排期</div>
          </div>
          <div class="bento-card">
            <div class="card-label">全局重置间隔中位数</div>
            <div class="card-value">{claude.typicalGapDays ?? '—'} <span class="unit">天</span></div>
            <div class="card-sub">已读取的近 30 天记录：{status === 'unavailable' ? '—' : claude.resets30d} 次重置，{status === 'unavailable' ? '—' : claude.cards30d} 次发卡</div>
            <div class="card-hint">来源：WhenReset.dev · 记录可能不完整</div>
          </div>
        </div>

        <!-- Window Time Calculator for Claude -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">五小时窗口时间计算器</h2>
              <p class="tool-sub">填写已知窗口起点，不是触顶时刻。这里只按五小时假设计算结束时间；个人实际重置时间请以产品内显示为准。</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="claude-window-start">已知窗口起点（北京时间）</label>
              <input type="datetime-local" id="claude-window-start" class="time-input" step="60" />
              <button type="button" id="claude-calculate" class="btn btn-dark">按 5 小时计算</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
              <div class="result-label">假设窗口结束时间（北京时间）</div>
              <div class="result-time" id="claude-calc-result">—</div>
              <div class="result-tips" id="claude-calc-tips">输入已知起点后点击计算按钮。</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Claude 重置与重置卡记录</h2>
            <span class="history-count">最多 30 条已读取记录 · 北京时间</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>日期 (北京时间)</th>
                  <th>类型</th>
                  <th>适用范围</th>
                  <th>触发原因 / 说明</th>
                  <th>距今</th>
                  <th>出处</th>
                </tr>
              </thead>
              <tbody>
                {claude.events.length === 0 && <tr><td colspan="6">暂无可用事件记录。</td></tr>}
                {claude.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>{e.typeLabelZh}</span>
                    </td>
                    <td class="cell-scope">{e.scopeZh}</td>
                    <td class="cell-reason">{e.reasonZh}</td>
                    <td class="cell-timeago">{e.timeAgoZh}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          推文 ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- FAQ & Strategy Section -->
      <section class="faq-section">
        <h2 class="faq-main-title">关于额度重置常见规则</h2>
        <div class="faq-grid">
          {faqItems.map((item) => (
            <div class="faq-item">
              <h3 class="faq-q">{item.q}</h3>
              <p class="faq-a" set:html={item.a} />
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initResetWindowCalculator } from '../../lib/reset-window';
  // Tab Switcher
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const sections = document.querySelectorAll<HTMLElement>('.provider-section');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const provider = btn.dataset.provider;
      tabBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      sections.forEach((sec) => {
        if (sec.id === `section-${provider}`) {
          sec.classList.add('active');
        } else {
          sec.classList.remove('active');
        }
      });
    });
  });

  initResetWindowCalculator('codex', 'zh');
  initResetWindowCalculator('claude', 'zh');
</script>

<style>
  .pulse-dot.unavailable { background: var(--text-tertiary); animation: none; }
  .reset-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
    min-height: 80vh;
  }

  .reset-hero {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-default);
  }

  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 12px;
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    font-size: var(--text-12);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    border-radius: 999px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }

  .hero-desc {
    max-width: 680px;
    color: var(--text-secondary);
    font-size: var(--text-15);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  .provider-tabs {
    display: flex;
    gap: var(--space-3);
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: var(--text-14);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-standard);
  }

  .tab-btn:hover {
    background: #fff;
    border-color: var(--color-ink-950);
    color: var(--color-ink-950);
  }

  .tab-btn.active {
    background: var(--color-ink-950);
    color: #fff;
    border-color: var(--color-ink-950);
  }

  .tab-badge {
    font-size: var(--text-10);
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .tab-btn:not(.active) .tab-badge {
    background: var(--border-default);
    color: var(--text-secondary);
  }

  .provider-section {
    display: none;
  }

  .provider-section.active {
    display: block;
  }

  /* Alert Banner */
  .alert-banner {
    margin-bottom: var(--space-8);
    padding: var(--space-5) var(--space-6);
    background: #fffbeb;
    border: 1px solid #fde68a;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .alert-icon {
    font-size: 1.8rem;
  }

  .alert-content {
    flex: 1;
  }

  .alert-title {
    font-weight: var(--font-weight-bold);
    color: #92400e;
    margin-bottom: 2px;
  }

  .alert-text {
    font-size: var(--text-13);
    color: #78350f;
    margin: 0;
  }

  .alert-meta {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: #b45309;
    margin-top: 4px;
  }

  .alert-btn {
    white-space: nowrap;
  }

  /* Stats Bento Grid */
  .stats-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .bento-card {
    background: #fff;
    border: 1px solid var(--border-default);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .card-label {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .card-value {
    font-size: 1.85rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-950);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }

  .card-value.highlight {
    color: #2563eb;
  }

  .card-value.accent {
    color: #059669;
  }

  .card-value.warn {
    color: #ea580c;
  }

  .time-sub {
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--text-secondary);
  }

  .unit {
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--text-tertiary);
  }

  .card-sub {
    font-size: var(--text-12);
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .card-hint {
    font-size: var(--text-10);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .card-link {
    font-size: var(--text-11);
    color: #2563eb;
    margin-top: var(--space-2);
    text-decoration: underline;
  }

