{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd design-systems/01-protocol/prototype && npm install",
  "buildCommand": "cd design-systems/01-protocol/prototype && npm run build",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/(fix-db|db-maint)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(contact|home)(/.*)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tsalon.tech"
        }
      ],
      "destination": "https://www.tsalon.tech/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tsalon.tech"
        }
      ],
      "destination": "https://www.tsalon.tech/$1",
      "permanent": true
    },
    {
      "source": "/reset{/}?",
      "destination": "/whenreset/",
      "permanent": true
    },
    {
      "source": "/whenrest{/}?",
      "destination": "/whenreset/",
      "permanent": true
    },
    {
      "source": "/en/reset{/}?",
      "destination": "/en/whenreset/",
      "permanent": true
    },
    {
      "source": "/en/whenrest{/}?",
      "destination": "/en/whenreset/",
      "permanent": true
    },
    {
      "source": "/archives{/}?",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/archives/(.*)",
      "destination": "/articles/$1",
      "permanent": true
    },
    {
      "source": "/en/archives{/}?",
      "destination": "/en/articles/",
      "permanent": true
    },
    {
      "source": "/en/archives/(.*)",
      "destination": "/en/articles/$1",
      "permanent": true
    },
    {
      "source": "/join{/}?",
      "destination": "/about/#join",
      "permanent": true
    },
    {
      "source": "/join/(.*)",
      "destination": "/about/#join",
      "permanent": true
    },
    {
      "source": "/gallery{/}?",
      "destination": "/history/",
      "permanent": true
    },
    {
      "source": "/gallery/(.*)",
      "destination": "/history/$1",
      "permanent": true
    },
    {
      "source": "/en/gallery{/}?",
      "destination": "/en/history/",
      "permanent": true
    },
    {
      "source": "/en/gallery/(.*)",
      "destination": "/en/history/$1",
      "permanent": true
    },
    {
      "source": "/stories{/}?",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/stories/(.*)",
      "destination": "/events/$1",
      "permanent": true
    },
    {
      "source": "/en/stories{/}?",
      "destination": "/en/events/",
      "permanent": true
    },
    {
      "source": "/en/stories/(.*)",
      "destination": "/en/events/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)/index.html",
      "destination": "/$1/",
      "permanent": true
    },
    {
      "source": "/en/articles/tchat-15{/}?",
      "destination": "/en/articles/tchat-bill-cross-platform-career-recap/",
      "permanent": true
    },
    {
      "source": "/en/articles/tchat-13{/}?",
      "destination": "/en/articles/tchat-caolicheng-client-architecture-recap/",
      "permanent": true
    },
    {
      "source": "/en/articles/tchat-4{/}?",
